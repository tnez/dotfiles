#!/usr/bin/env python3
"""Check or repair three absent agent links on Omarchy; never reset settings."""

import argparse
import json
import os
from pathlib import Path
import platform
import shlex
import subprocess
import sys
import tempfile

HOOK_NAME = '90-dotfiles-agent-links'
EVENTS = ('post-update', 'post-boot')
PREFERENCES = {
    'enableInstallTelemetry': False,
    'quietStartup': True,
    'treeFilterMode': 'no-tools',
}
LINKS = {
    'AGENTS.md': 'agents/AGENTS.md',
    '.pi/agent/AGENTS.md': 'pi/dot-pi/agent/AGENTS.md',
    '.pi/agent/keybindings.json': 'pi/dot-pi/agent/keybindings.json',
}


class Conflict(Exception):
    pass


def is_omarchy():
    return (platform.system() == 'Linux'
            and platform.freedesktop_os_release().get('ID') == 'omarchy')


def real_parents(path, home):
    """Require existing, real parents: do not follow or recreate agent dirs."""
    for parent in (path.parent, *path.parent.parents):
        if parent == home:
            return
        if parent.is_symlink() or not parent.is_dir():
            raise Conflict(f'inspect missing or redirected parent: {parent}')
    raise Conflict('target is outside HOME')


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise Conflict('duplicate JSON keys; preserve and review settings')
        result[key] = value
    return result


def inspect(root, home):
    kb = Path(os.environ.get('TNEZDEV_KNOWLEDGE_BASE_ROOT', ''))
    if not kb.is_absolute():
        raise Conflict('configure absolute TNEZDEV_KNOWLEDGE_BASE_ROOT')
    for relative in ('AGENTS.md', 'root/index.md',
                     'root/meta/agent-consumption.md'):
        if not os.access(kb / relative, os.R_OK):
            raise Conflict(f'KB entrypoint is unreadable: {relative}')
    missing = []
    for relative, source in LINKS.items():
        target, source = home / relative, root / source
        real_parents(target, home)
        if (not source.is_file() or not os.access(source, os.R_OK)
                or not source.resolve().is_relative_to(root)):
            raise Conflict(f'inspect missing/redirected source: {relative}')
        if not os.path.lexists(target):
            print(f'MISSING: ~/{relative}')
            missing.append((target, source))
        elif not target.is_symlink() or target.resolve() != source.resolve():
            raise Conflict(f'preserve conflicting target: ~/{relative}')
        else:
            print(f'OK: ~/{relative}')
    settings = home / '.pi/agent/settings.json'
    if settings.is_symlink() or not settings.is_file():
        raise Conflict('inspect missing or redirected Pi settings.json')
    data = json.loads(settings.read_text(), object_pairs_hook=unique_object)
    if not isinstance(data, dict):
        raise Conflict('Pi settings must be a JSON object')
    for key, expected in PREFERENCES.items():
        actual = data.get(key)
        if type(actual) is not type(expected) or actual != expected:
            raise Conflict(f'Pi preference drift: {key}; choose local or '
                           'declared preference; no automatic overwrite')
    print('OK: KB entrypoints and three Pi preferences (theme unmanaged)')
    return missing


def authorize(root, yes):
    if not yes:
        raise Conflict('mutation requires explicit approval and --yes')
    git = root / '.git'
    if git.is_symlink() or not git.is_dir():
        raise Conflict('use the canonical primary checkout (.git directory)')
    for command in ('doctor', 'plan'):
        result = subprocess.run([str(root / 'dotfiles'), command],
                                capture_output=True, text=True, timeout=60,
                                check=False)
        output = result.stdout + result.stderr
        if result.returncode or 'ACTION_REQUIRED' in output:
            print(output, end='')
            raise Conflict(f'resolve dotfiles {command} findings first')
        print(f'OK: dotfiles {command}')


def repair(root, home):
    # Reinspect after doctor/plan; a conflict anywhere prevents all link writes.
    for target, source in inspect(root, home):
        real_parents(target, home)
        # symlink creation is no-clobber, including dangling links and races.
        target.symlink_to(os.path.relpath(source, target.parent))
        if not target.is_symlink() or target.resolve() != source.resolve():
            raise Conflict('link verification failed; inspect partial repair')
        print(f'REPAIRED: ~/{target.relative_to(home)}')
    inspect(root, home)


def hook_text(root, kb):
    # These machine-local paths live only in installed copies, never in Git.
    runbook = shlex.quote(str(root / 'omarchy-agent-links'))
    return f'''#!/bin/bash
# Generated by omarchy-agent-links; repair absent links only.
[[ $(uname -s) == Linux ]] || exit 0
kb_root={shlex.quote(kb)}
runbook={runbook}
TNEZDEV_KNOWLEDGE_BASE_ROOT=${{TNEZDEV_KNOWLEDGE_BASE_ROOT:-$kb_root}}
export TNEZDEV_KNOWLEDGE_BASE_ROOT
if output=$(python3 "$runbook" repair --yes 2>&1); then
  printf '%s\\n' "$output"
else
  status=$?
  printf '%s\\n' "$output" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u normal 'Dotfiles agent links need review' \\
      'Run omarchy-agent-links check from the primary checkout.' || true
  fi
  exit "$status"
fi
'''


def install_hooks(root, home):
    # Omarchy's runner uses ~/.config, not XDG_CONFIG_HOME.
    content = hook_text(root, os.environ['TNEZDEV_KNOWLEDGE_BASE_ROOT'])
    targets = [home / '.config/omarchy/hooks' / (event + '.d') / HOOK_NAME
               for event in EVENTS]
    for target in targets:
        real_parents(target, home)
        if os.path.lexists(target) and (
                target.is_symlink() or not target.is_file()
                or target.read_text() != content):
            raise Conflict(f'preserve existing hook: {target.name}')
    with tempfile.TemporaryDirectory(prefix='dotfiles-agent-hook-') as temp:
        source = Path(temp) / HOOK_NAME
        source.write_text(content)
        for event, target in zip(EVENTS, targets):
            # Recheck immediately before native installation; keep hook/config
            # writers idle. The native installer copies (not an atomic CAS).
            if os.path.lexists(target):
                if (target.is_symlink() or not target.is_file()
                        or target.read_text() != content):
                    raise Conflict('hook changed during review; inspect it')
                print(f'OK: existing {event} hook')
                continue
            subprocess.run(['omarchy', 'hook', 'install', event, str(source)],
                           check=True, timeout=30)
            if (target.is_symlink() or target.read_text() != content
                    or not os.access(target, os.X_OK)):
                raise Conflict('hook verification failed; '
                               'inspect partial setup')
            print(f'INSTALLED: {event} hook')


def run(args, root, home):
    if not is_omarchy():
        print('SKIP: agent-link recovery is Omarchy-only (no changes)')
        return 0
    try:
        missing = inspect(root, home)
        if args.command == 'check':
            return 1 if missing else 0
        authorize(root, args.yes)
        if args.command == 'repair':
            repair(root, home)
        else:
            if missing:
                raise Conflict('repair missing links before enabling hooks')
            install_hooks(root, home)
        return 0
    except (Conflict, OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f'ACTION_REQUIRED: {exc}', file=sys.stderr)
        print('Stopped; preserve local state and inspect any partial work.',
              file=sys.stderr)
        return 3


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('check', 'repair', 'install-hooks'))
    parser.add_argument('--yes', action='store_true',
                        help='approve this mutation; cannot override conflicts')
    return run(parser.parse_args(), Path(__file__).resolve().parent,
               Path.home())


if __name__ == '__main__':
    sys.exit(main())
