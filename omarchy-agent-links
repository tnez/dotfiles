#!/usr/bin/env python3
"""Compatibility entrypoint: link repair is retired; never recreate links."""

import os
from pathlib import Path
import sys

if __name__ == '__main__':
    if sys.argv[1:] == ['check']:
        runbook = Path(__file__).resolve().with_name('agent-config')
        os.execv(sys.executable, [sys.executable, str(runbook), 'check'])
    print('ACTION_REQUIRED: agent link repair/hooks are retired. '
          'Disable verified old hooks and review ./agent-config plan; '
          'see docs/runbooks/agent-config.md.', file=sys.stderr)
    sys.exit(3)
