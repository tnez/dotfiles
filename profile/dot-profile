# vim: ft=sh
# shellcheck shell=sh

# POSIX environment only: no runtime installation or interactive shell hooks.
path_prepend() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1${PATH:+:$PATH}" ;;
  esac
}

# Homebrew locations are harmless on hosts without these directories.
path_prepend /usr/local/bin
path_prepend /opt/homebrew/bin
path_prepend /opt/homebrew/sbin
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.scripts"
# Noninteractive shells/GUI applications use mise shims, not a pinned runtime.
path_prepend "${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
export PATH

export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/rg.conf"
export BAT_THEME=ansi

# Keep machine paths out of the portable configuration. Loaded last so local
# choices (including EDITOR and PATH) actually override the defaults above.
# shellcheck disable=SC1091
[ ! -f "$HOME/.profile.local" ] || . "$HOME/.profile.local"
export TNEZ_PROFILE_LOADED=1
unset -f path_prepend
