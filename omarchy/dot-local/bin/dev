#!/usr/bin/env bash
# Compatibility source for existing Omarchy links; new installs use dev/.
set -euo pipefail

source_path=${BASH_SOURCE[0]}
while [[ -L $source_path ]]; do
  source_dir=$(cd -P "$(dirname "$source_path")" && pwd)
  target=$(readlink "$source_path")
  case $target in
    /*) source_path=$target ;;
    *) source_path=$source_dir/$target ;;
  esac
done
source_dir=$(cd -P "$(dirname "$source_path")" && pwd)
repo=$(cd "$source_dir/../../.." && pwd)
exec "$repo/dev/dot-local/bin/dev" "$@"
