# vim: ft=gitconfig

[user]
  name = Travis Nesland
  email = travis@tnez.dev
[github]
  user = tnez
[alias]
  a = add
  aa = add .
  b = checkout -b
  bd = branch -d
  c = commit
  ca = commit --amend
  cm = commit -m
  co = checkout
  copr = pr checkout
  d = diff
  f = fetch --all --prune
  l = log --oneline --graph
  m = merge
  pf = push --force-with-lease
  r = rebase
  ri = rebase --interactive
  s = status
  wt = worktree
  z = stash
  zl = stash list
  zp = stash pop
  zz = stash push -u -m
[init]
  defaultBranch = main
[core]
  editor = "nvim"
  excludesfile = ~/.gitignore
  pager = less
[diff]
  colorMoved = default
[fetch]
  prune = true
[pull]
  rebase = true
[merge]
  conflictstyle = diff3
[rebase]
  autosquash = true
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
