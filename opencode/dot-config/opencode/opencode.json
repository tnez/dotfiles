{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "code",
  "agent": {
    "build": {
      "disable": true
    },
    "explore": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "plan": {
      "disable": true
    }
  },
  "autoupdate": true,
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  }
}
